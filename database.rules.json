{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['revision', 'payloadText']) && newData.child('revision').isNumber() && newData.child('payloadText').isString()"
      }
    }
  }
}
